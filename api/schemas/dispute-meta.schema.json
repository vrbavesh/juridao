{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "api/schemas/dispute-meta.schema.json",
  "title": "Dispute template (raiseDispute metaURI payload)",
  "type": "object",
  "required": ["version", "dealId", "title", "question", "answers", "criteria", "deliveryURI", "courtId"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "dealId": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "answers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": [1, 2] },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "deliveryURI": { "type": "string" },
    "courtId": { "type": "integer", "minimum": 1 }
  }
}
