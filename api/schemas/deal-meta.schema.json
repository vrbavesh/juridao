{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "api/schemas/deal-meta.schema.json",
  "title": "Deal metadata (deal.metaURI payload)",
  "type": "object",
  "required": ["title", "description", "deliveryCriteria"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "deliveryCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
